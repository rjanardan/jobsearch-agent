# Copy to .env and fill. Never commit .env.

# Model routing (LiteLLM)
DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com
OLLAMA_BASE_URL=http://localhost:11434

# Model names by role (local names must exist in `ollama list`)
MODEL_REASON=deepseek/deepseek-chat
MODEL_LOCAL=ollama/qwen3:4b-32k
MODEL_EMBED=ollama/nomic-embed-text

# Postgres
PG_DSN=postgresql://jobagent:jobagent@localhost:5432/jobagent

# OTel traces
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:6006
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006

# Tracker integration (public jobs.json mirror)
TRACKER_REPO_PATH=~/github/rjanardan
TRACKER_JOBS_FILE=data/jobs.json

# LinkedIn module (optional, per-job opt-in)
LINKEDIN_CACHE_DIR=private/linkedin
