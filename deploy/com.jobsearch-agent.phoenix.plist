<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.jobsearch-agent.phoenix</string>
  <key>ProgramArguments</key>
  <array>
    <string>__REPO__/.venv/bin/phoenix</string>
    <string>serve</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__REPO__</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>__HOME__/Library/Logs/jobsearch-agent/phoenix.out.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/Library/Logs/jobsearch-agent/phoenix.err.log</string>
</dict>
</plist>
