<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.jobsearch-agent.nightly</string>
  <key>ProgramArguments</key>
  <array>
    <string>__REPO__/.venv/bin/ja</string>
    <string>nightly</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__REPO__</string>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>2</integer>
    <key>Minute</key>
    <integer>30</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>__HOME__/Library/Logs/jobsearch-agent/nightly.out.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/Library/Logs/jobsearch-agent/nightly.err.log</string>
</dict>
</plist>
